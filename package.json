{
  "name": "racing-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "JBIS 出走表（中央/地方 × 场 × 父 / 父父 / 母父 / 比赛格）采集、筛选与每周 Excel",
  "scripts": {
    "collect": "node src/collect-races.js",
    "graded:collect": "node src/global/collect.mjs",
    "graded:fetch": "node src/global/collect.mjs --fetch",
    "graded:serve": "node src/global/server.mjs",
    "graded:backfill": "node src/global/backfill.mjs --year 2026 --region all",
    "graded:backfill:jp": "node src/global/backfill.mjs --year 2026 --region japan",
    "graded:backfill:ov": "node src/global/backfill.mjs --year 2026 --region overseas",
    "collect:waku": "node src/backfill-waku.js",
    "collect:rp": "node src/collect-sources.js --source racingpost",
    "collect:tjk": "node src/collect-sources.js --source tjk",
    "collect:tjk:probe": "node src/sources/tjk.probe.js",
    "collect:pop": "node src/collect-recent-pop.js",
    "collect:results": "node src/collect-results.js",
    "collect:results:rp": "node src/collect-results-rp.js",
    "collect:results:tjk": "node src/collect-results-tjk.js",
    "build": "node src/build.js",
    "test": "node test/guard.test.mjs && node test/tjk-result.test.mjs && node test/tjk-sire.test.mjs && node test/age.test.mjs && node test/global-graded.test.mjs",
    "audit:homonym": "node src/audit-homonym.js",
    "migrate:lookup": "node src/migrate-lookup-v2.js",
    "serve": "node src/server.js",
    "start": "node src/collect-races.js && node src/build.js && node src/server.js",
    "backfill:bra-ped": "node src/backfill-bra-ped.js",
    "backfill:arg-ped": "node src/backfill-arg-ped.js",
    "enrich:jcb": "node src/enrich-jcb.js",
    "strip:frame": "node src/strip-foreign-frame.js",
    "backfill:bra-results": "node src/backfill-bra-results.js",
    "collect:sa": "node src/collect-sources.js --source turfeonline && node src/collect-sources.js --source sanisidro && node src/collect-sources.js --source laplata && node src/collect-sources.js --source teletrak",
    "collect:results:tol": "node src/collect-results-tol.js --days 2",
    "collect:results:si": "node src/collect-results-si.js --days 2",
    "collect:results:chs": "node src/collect-results-chs.js --days 3",
    "rebuild:tk-card": "node src/rebuild-tk-card.js"
  }
}
